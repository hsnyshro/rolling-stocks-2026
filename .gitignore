# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloudflare
.open-next/
.wrangler/
.dev.vars
cloudflare-env.d.ts
/.superpowers/

# Playwright
/test-results/
/playwright-report/

# Claude Code のローカル設定（個人の許可設定。共有しない）
.claude/settings.local.json

# ログ
*.log

# 開発の作業記録・発表資料（アプリの動作に関係しないため公開リポジトリに含めない。手元のファイルはそのまま使える）
/tasks/
/progress-tracking.md
/presentation/
